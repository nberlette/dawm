{
  "name": "dawm-xhr",
  "version": "0.1.0-rc.9",
  "description": "XMLHttpRequest implementation for dawm headless DOM environments.",
  "author": {
    "name": "Nicholas Berlette",
    "email": "nick@berlette.com",
    "url": "https://github.com/nberlette"
  },
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/nberlette/dawm/tree/main/packages/xhr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nberlette/dawm.git",
    "directory": "packages/xhr"
  },
  "bugs": {
    "url": "https://github.com/nberlette/dawm/issues/new?title=%5Bdawm-xhr%5D%20"
  },
  "keywords": [
    "dawm",
    "http",
    "networking",
    "typescript",
    "xhr",
    "xmlhttprequest"
  ],
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "files": [
    "src",
    "esm",
    "cjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "source": "./src/index.ts",
      "deno": "./src/index.ts",
      "require": {
        "types": "./cjs/index.d.ts",
        "default": "./cjs/index.js"
      },
      "default": "./esm/index.js"
    },
    "./xml-http-request": {
      "types": "./esm/XMLHttpRequest.d.ts",
      "source": "./src/XMLHttpRequest.ts",
      "deno": "./src/XMLHttpRequest.ts",
      "require": {
        "types": "./cjs/XMLHttpRequest.d.ts",
        "default": "./cjs/XMLHttpRequest.js"
      },
      "default": "./esm/XMLHttpRequest.js"
    },
    "./xml-http-request-event-target": {
      "types": "./esm/XMLHttpRequestEventTarget.d.ts",
      "source": "./src/XMLHttpRequestEventTarget.ts",
      "deno": "./src/XMLHttpRequestEventTarget.ts",
      "require": {
        "types": "./cjs/XMLHttpRequestEventTarget.d.ts",
        "default": "./cjs/XMLHttpRequestEventTarget.js"
      },
      "default": "./esm/XMLHttpRequestEventTarget.js"
    },
    "./xml-http-request-upload": {
      "types": "./esm/XMLHttpRequestUpload.d.ts",
      "source": "./src/XMLHttpRequestUpload.ts",
      "deno": "./src/XMLHttpRequestUpload.ts",
      "require": {
        "types": "./cjs/XMLHttpRequestUpload.d.ts",
        "default": "./cjs/XMLHttpRequestUpload.js"
      },
      "default": "./esm/XMLHttpRequestUpload.js"
    }
  },
  "dependencies": {
    "dawm-core": "workspace:0.1.0-rc.9",
    "dawm-internal": "workspace:0.1.0-rc.9",
    "dawm-xml": "workspace:0.1.0-rc.9"
  }
}
