{
  "name": "dawm",
  "version": "0.1.0-rc.9",
  "description": "High-performance headless DOM toolkit with parser packages and DOM APIs implemented in TypeScript.",
  "author": {
    "name": "Nicholas Berlette",
    "email": "nick@berlette.com",
    "url": "https://github.com/nberlette"
  },
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/nberlette/dawm/tree/main/packages/dawm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nberlette/dawm.git",
    "directory": "packages/dawm"
  },
  "bugs": {
    "url": "https://github.com/nberlette/dawm/issues/new?title=%5Bdawm%5D%20"
  },
  "keywords": [
    "css",
    "dawm",
    "dom",
    "headless",
    "html",
    "parser",
    "typescript",
    "xml"
  ],
  "main": "./cjs/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "files": [
    "src",
    "esm",
    "cjs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./esm/index.d.ts",
      "source": "./src/index.ts",
      "deno": "./src/index.ts",
      "require": {
        "types": "./cjs/index.d.ts",
        "default": "./cjs/index.js"
      },
      "default": "./esm/index.js"
    },
    "./global": {
      "types": "./esm/global.d.ts",
      "source": "./src/global.ts",
      "deno": "./src/global.ts",
      "require": {
        "types": "./cjs/global.d.ts",
        "default": "./cjs/global.js"
      },
      "default": "./esm/global.js"
    },
    "./guards": {
      "types": "./esm/guards.d.ts",
      "source": "./src/guards.ts",
      "deno": "./src/guards.ts",
      "require": {
        "types": "./cjs/guards.d.ts",
        "default": "./cjs/guards.js"
      },
      "default": "./esm/guards.js"
    },
    "./options": {
      "types": "./esm/options.d.ts",
      "source": "./src/options.ts",
      "deno": "./src/options.ts",
      "require": {
        "types": "./cjs/options.d.ts",
        "default": "./cjs/options.js"
      },
      "default": "./esm/options.js"
    },
    "./parse": {
      "types": "./esm/parse.d.ts",
      "source": "./src/parse.ts",
      "deno": "./src/parse.ts",
      "require": {
        "types": "./cjs/parse.d.ts",
        "default": "./cjs/parse.js"
      },
      "default": "./esm/parse.js"
    },
    "./serialize": {
      "types": "./esm/serialize.d.ts",
      "source": "./src/serialize.ts",
      "deno": "./src/serialize.ts",
      "require": {
        "types": "./cjs/serialize.d.ts",
        "default": "./cjs/serialize.js"
      },
      "default": "./esm/serialize.js"
    },
    "./types": {
      "types": "./esm/types.d.ts",
      "source": "./src/types.ts",
      "deno": "./src/types.ts",
      "require": {
        "types": "./cjs/types.d.ts",
        "default": "./cjs/types.js"
      },
      "default": "./esm/types.js"
    }
  },
  "dependencies": {
    "dawm-cache": "workspace:0.1.0-rc.9",
    "dawm-console": "workspace:0.1.0-rc.9",
    "dawm-core": "workspace:0.1.0-rc.9",
    "dawm-css": "workspace:0.1.0-rc.9",
    "dawm-encoding": "workspace:0.1.0-rc.9",
    "dawm-fetch": "workspace:0.1.0-rc.9",
    "dawm-html": "workspace:0.1.0-rc.9",
    "dawm-internal": "workspace:0.1.0-rc.9",
    "dawm-navigator": "workspace:0.1.0-rc.9",
    "dawm-storage": "workspace:0.1.0-rc.9",
    "dawm-tree": "workspace:0.1.0-rc.9",
    "dawm-url": "workspace:0.1.0-rc.9",
    "dawm-view": "workspace:0.1.0-rc.9",
    "dawm-webidl": "workspace:0.1.0-rc.9",
    "dawm-xhr": "workspace:0.1.0-rc.9",
    "dawm-xml": "workspace:0.1.0-rc.9",
    "dawm-xpath": "workspace:0.1.0-rc.9"
  }
}
